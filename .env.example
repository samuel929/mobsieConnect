DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=mobsie-connect
JWT_AUDIENCE=mobsie-admin
NEXT_PUBLIC_TENANT_ID=
ALLOWED_ORIGINS=

# Server-side API rate limiting. A Vercel/Upstash integration may provide
# these as KV_REST_API_URL and KV_REST_API_TOKEN instead; both are supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP settings used by Nodemailer for application approval emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Mobsie Kids <admissions@example.com>"

# PayFast hosted checkout. PUBLIC_APP_URL must be a public HTTPS URL so PayFast can reach the ITN webhook.
PUBLIC_APP_URL=
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
